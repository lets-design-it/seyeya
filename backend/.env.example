# Database
# Local PostgreSQL setup:
# DATABASE_URL=postgresql+asyncpg://seyeya_user:seyeya_password@localhost:5432/seyeya_db
# DATABASE_SYNC_URL=postgresql://seyeya_user:seyeya_password@localhost:5432/seyeya_db

# Neon Serverless PostgreSQL setup (paste your connection strings directly):
# DATABASE_URL=postgresql+asyncpg://username:password@ep-host.region.aws.neon.tech/neondb?ssl=require
# DATABASE_SYNC_URL=postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
# Note: You can also paste the standard connection strings directly from the Neon dashboard.
# The backend automatically formats the connection schemas and maps sslmode=require to ssl=require for asyncpg.
# Shared Development Neon Database (default)
DATABASE_URL="postgresql://neondb_owner:npg_qLkyd6hWZHg8@ep-plain-credit-ad9ex0q7-pooler.c-2.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_SYNC_URL="postgresql://neondb_owner:npg_qLkyd6hWZHg8@ep-plain-credit-ad9ex0q7.c-2.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email/SMS Integration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SEND_FROM_EMAIL=noreply@seyeyacourts.com

# API
API_VERSION=v1
DEBUG=True
ENVIRONMENT=development



# TricsoftPay Business account
TRICSOFTPAY_ACCOUNT_TYPE=business
TRICSOFTPAY_ENVIRONMENT=sandbox
TRICSOFTPAY_BASE_URL=https://sandbox.tricsoftpay.com/api
TRICSOFTPAY_API_KEY_ID=your_business_api_key_id_here
TRICSOFTPAY_API_SECRET=your_business_api_secret_here
TRICSOFTPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Compatibility names are supported during migration, but the TRICSOFTPAY_* names above are authoritative.
